# Example environment for Next.js frontend

# ===== API Backend =====
# URL de l'API backend FastAPI (Render ou localhost)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ===== Site Metadata =====
NEXT_PUBLIC_SITE_URL=https://fitidion.vercel.app

# ===== SerpAPI =====
# Clé API pour les recherches produits
SERPAPI_KEY=your-serpapi-key-here
NEXT_PUBLIC_SERPAPI_KEY=your-serpapi-key-here

# ===== Scraper API (optionnel) =====
SCRAPER_API_KEY=your-scraper-api-key-here

# ===== Analytics (Umami - optionnel) =====
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.umami.is/script.js

